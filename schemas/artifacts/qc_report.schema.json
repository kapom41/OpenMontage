{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/qc_report",
  "title": "Quality Control Report",
  "description": "Technical and creative validation results for a rendered video.",
  "type": "object",
  "required": ["video_path", "overall_passed", "overall_score", "technical_score", "creative_score", "results", "generated_at", "metadata"],
  "properties": {
    "video_path": { "type": "string" },
    "overall_passed": { "type": "boolean" },
    "overall_score": { "type": "number" },
    "technical_score": { "type": "number" },
    "creative_score": { "type": "number" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_name": { "type": "string" },
          "category": { "type": "string", "enum": ["technical", "creative"] },
          "passed": { "type": "boolean" },
          "score": { "type": "number" },
          "details": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "major", "minor", "info"] }
        }
      }
    },
    "generated_at": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}